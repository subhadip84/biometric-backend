# Copy this file to .env for local testing (or set these as environment
# variables directly in your hosting provider's dashboard for deployment).

# The full contents of your downloaded service account JSON key file,
# pasted as a single line (most hosts want this as one line - see README).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Your Google Sheet's ID - the long string in its URL between /d/ and /edit
# e.g. for https://docs.google.com/spreadsheets/d/1AbCdEfG.../edit
# the ID is: 1AbCdEfG...
SPREADSHEET_ID=your-spreadsheet-id-here

# Your GitHub Pages URL, for CORS - e.g. https://subhadip84.github.io
# Leave blank/remove to allow any origin (less strict, but works immediately)
ALLOWED_ORIGIN=https://subhadip84.github.io

PORT=3000
